<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- XML comments feed the Swagger descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed only at design time for "dotnet ef" (this is the startup project). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Requests.Application\Requests.Application.csproj" />
    <ProjectReference Include="..\Requests.Infrastructure\Requests.Infrastructure.csproj" />
  </ItemGroup>

</Project>
