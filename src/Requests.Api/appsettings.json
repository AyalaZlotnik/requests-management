{
  "ConnectionStrings": {
    "RequestsDb": "Server=(localdb)\\MSSQLLocalDB;Database=RequestsManagement;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Cache": {
    "SummaryTtlSeconds": 60
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
